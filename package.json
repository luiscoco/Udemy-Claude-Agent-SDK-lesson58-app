{
  "name": "claude-agent-sdk-lesson58-docker-deployment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deploy an actual Agent SDK HTTP service in Docker; external transcript store, replacement and replica recovery",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "agent": "npm run sample:env",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test src/agent.test.ts src/startup.test.ts",
    "sample": "tsx src/sample.ts",
    "sample:env": "tsx --env-file-if-exists=.env src/sample.ts",
    "pipeline": "tsx --env-file-if-exists=.env src/sample.ts",
    "eval": "npm run pipeline -- replicas",
    "docker:build": "docker build -t claude-sdk-lesson58:local .",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
